# Copy to .env. Never commit real credentials.
# Prefer `python -m modal setup` for an interactive developer account.
# Optional server-side authentication for a dedicated Modal deployment.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# Independent app, volume and secret prefix; deploy again if changed.
FRAMEFORGE_NAMESPACE=frameforge
# Optional access token for the local studio. Keep the server on loopback.
STUDIO_API_TOKEN=
STUDIO_PORT=8000
